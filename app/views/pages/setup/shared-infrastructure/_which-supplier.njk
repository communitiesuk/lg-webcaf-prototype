{# "Which supplier?" reveal, shared by the fully/partly options on S12c.
   Included with `supplierGroup` set to "fully" or "partly" for unique input ids. #}
<div class="govuk-form-group govuk-!-margin-bottom-0">
  <fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Which supplier?</legend>
    <div class="govuk-radios" data-module="govuk-radios">
      {% for s in suppliers %}
        <div class="govuk-radios__item">
          <input class="govuk-radios__input" id="whichSupplier-{{ supplierGroup }}-{{ loop.index }}" name="whichSupplier" type="radio" value="{{ s.id }}" {% if platform.supplierId == s.id %}checked{% endif %}>
          <label class="govuk-label govuk-radios__label" for="whichSupplier-{{ supplierGroup }}-{{ loop.index }}">{{ s.name }}</label>
        </div>
      {% endfor %}
    </div>
  </fieldset>
  <p class="govuk-body govuk-!-margin-top-2">
    <a class="govuk-link" href="/setup/suppliers/add?return=platform">Add a supplier that is not listed</a>
  </p>
</div>
